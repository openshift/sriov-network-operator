#!/bin/bash

podman_tag_and_push() {
  local_image=$1
  cluster_image=$2

  echo "## Pushing ${local_image} to cluster registry ${cluster_image}"
  podman tag ${local_image} ${cluster_image}
  podman push --tls-verify=false ${cluster_image}
}

validate_mock_driver_repo() {
  [[ $1 =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?/[a-zA-Z0-9._/-]+$ ]] || {
    echo 'Mock driver requires an HTTPS repository.' >&2
    return 1
  }
}

fetch_mock_driver_source() {
  local repo=$1 source_dir=$2
  if [[ ! -d $source_dir ]]; then
    git clone --depth 1 --single-branch --branch main -- "$repo" "$source_dir"
  fi
}
